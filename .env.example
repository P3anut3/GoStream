GOSTREAM_DSN="root:YOUR_PASSWORD@tcp(127.0.0.1:13306)/gostream?charset=utf8mb4&parseTime=true&loc=Local"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
GOSTREAM_FEED_CURSOR_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES

# Optional overrides shared by API and cleanup; otherwise use internal/config/config.yaml.
# GOSTREAM_HTTP_ADDR=127.0.0.1:8080
# GOSTREAM_VIDEO_DIR=uploads/videos
# GOSTREAM_COVER_DIR=uploads/covers

# Optional Redis for caches, shared rate-limit counters and login sessions. Leave unset to read
# MySQL directly and keep counters and sessions in this process (everyone signs in again after a restart).
# GOSTREAM_REDIS_ADDR=127.0.0.1:16379
# GOSTREAM_REDIS_PASSWORD=

# RabbitMQ address for cmd/worker only (the outbox relay); the API does not use it. URL-encode
# special characters in the password, e.g. @ as %40. The Compose worker gets its own from compose.yaml.
# GOSTREAM_AMQP_URL=amqp://gostream:YOUR_PASSWORD@127.0.0.1:15673/

# Send the refresh-token cookie over HTTPS only: true or false (unset means false).
# Keep false for http://127.0.0.1; set true when the site is served over HTTPS.
# GOSTREAM_SECURE_COOKIE=false
